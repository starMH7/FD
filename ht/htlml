
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mon adresse IP</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #111827;
      color: white;
      text-align: center;
      padding: 60px 20px;
    }
    .carte {
      max-width: 400px;
      margin: auto;
      padding: 30px;
      background: #1f2937;
      border-radius: 16px;
    }
    button {
      padding: 12px 20px;
      border: 0;
      border-radius: 8px;
      cursor: pointer;
      background: #3b82f6;
      color: white;
    }
    #ip {
      font-size: 22px;
      margin: 25px 0;
      overflow-wrap: anywhere;
    }
  </style>
</head>
<body>
  <div class="carte">
    <h1>Mon adresse IP</h1>
    <p>Ton adresse IP publique est :</p>
    <div id="ip">Chargement...</div>
    <button onclick="getIP()">Voir mon IP</button>
  </div>

  <script>
    async function getIP() {
      document.getElementById("ip").textContent =
        "Chargement...";
      try {
        const response = await fetch("https://api.ipify.org?format=json");
        const data = await response.json();
        document.getElementById("ip").textContent = data.ip;
      } catch {
        document.getElementById("ip").textContent =
          "Impossible de récupérer l'IP.";
      }
    }
    getIP();
  </script>
</body>
</html>
